---
/**
 * Blog detail — root English version served at /blog/<slug>/.
 * Each prefixed locale has its own copy under src/pages/[lang]/blog/[slug].astro.
 */

import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/blog/PostMeta.astro';
import PostToc from '../../components/blog/PostToc.astro';
import RelatedPosts from '../../components/blog/RelatedPosts.astro';
import SourceCallout from '../../components/blog/SourceCallout.astro';
import { HREFLANG_CODES, SITE_URL } from '../../consts';
import type { Locale } from '../../consts';
import { t, localeUrl } from '../../utils/i18n';
import {
  estimateReadingMinutes,
  sortByDateDesc,
} from '../../utils/blog';

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  // Root path serves English posts only.
  return all
    .filter((p) => p.id.startsWith('en/'))
    .map((p) => {
      const basename = (p.id.split('/').pop() ?? p.id).replace(/\.mdx?$/, '');
      return {
        params: { slug: basename },
        props: { locale: 'en' as Locale, slug: basename, entry: p },
      };
    });
}

const props = Astro.props;
const { locale, entry } = props;
const { Content, headings } = await render(entry);

const all = await getCollection('blog', ({ data }) => !data.draft);
const localePosts = all
  .filter((p) => p.id.startsWith(`${locale}/`))
  .sort(sortByDateDesc);

const readingMinutes = estimateReadingMinutes(entry.body ?? '');
const updatedDate = entry.data.updatedDate;

const basename = (entry.id.split('/').pop() ?? entry.id).replace(/\.mdx?$/, '');

const alternateLocales: Locale[] = Array.from(
  new Set<Locale>([
    locale,
    ...Object.keys(entry.data.translations ?? {}) as Locale[],
  ])
);

const postPath = `/blog/${basename}/`;
const canonicalPostUrl = new URL(localeUrl(locale as any, postPath), SITE_URL).toString();
const postImage = entry.data.hero?.src
  ? new URL(entry.data.hero.src, SITE_URL).toString()
  : new URL('/og-default.png', SITE_URL).toString();

// Resolve the author entry so JSON-LD uses the real `name` and any social
// links as `sameAs` instead of fabricating a name from the author id.
const authorEntry = await getEntry(entry.data.author);
const authorSameAs = authorEntry
  ? Object.values(authorEntry.data.links).filter(Boolean)
  : [];

// Guard against frontmatter typos where updatedDate predates pubDate —
// Google's Article rich-results check requires dateModified >= datePublished.
const safeUpdatedDate =
  updatedDate && updatedDate.getTime() >= entry.data.pubDate.getTime()
    ? updatedDate
    : undefined;

const blogPostingJsonLd = {
  '@type': 'BlogPosting',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalPostUrl,
  },
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.pubDate.toISOString(),
  ...(safeUpdatedDate ? { dateModified: safeUpdatedDate.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: authorEntry?.data.name ?? entry.data.author.id.replace(/-/g, ' '),
    ...(authorSameAs.length > 0 ? { sameAs: authorSameAs } : {}),
  },
  publisher: { '@id': new URL('/#organization', SITE_URL).toString() },
  image: [
    {
      '@type': 'ImageObject',
      url: postImage,
    },
  ],
  articleSection: entry.data.category,
  inLanguage: HREFLANG_CODES[locale as Locale],
  keywords: entry.data.tags?.join(', '),
  wordCount: entry.body?.trim().split(/\s+/).filter(Boolean).length,
  url: canonicalPostUrl,
};

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(locale as any, 'nav.blog'),
      item: new URL(localeUrl(locale as any, '/blog/'), SITE_URL).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: entry.data.title,
      item: new URL(localeUrl(locale as any, `/blog/${basename}/`), SITE_URL).toString(),
    },
  ],
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  pubDate={entry.data.pubDate}
  updatedDate={updatedDate}
  locale={locale}
  path={postPath}
  alternateLocales={alternateLocales}
  articleSection={entry.data.category}
  articleTags={entry.data.tags}
  jsonLd={[blogPostingJsonLd, breadcrumbJsonLd]}
>
  <a
    href={localeUrl(locale as any, '/blog/')}
    class="text-xs text-text-secondary hover:text-white inline-flex items-center gap-1 mb-4"
  >
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <polyline points="15,18 9,12 15,6" />
    </svg>
    {t(locale as any, 'common.backToBlog')}
  </a>

  <article class="grid gap-9 lg:grid-cols-[1fr_280px]">
    <div>
      <header class="mb-7">
        <h1 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-white text-balance">
          {entry.data.title}
        </h1>
        <p class="mt-3 text-lg text-text-secondary max-w-2xl text-balance">
          {entry.data.description}
        </p>
        <div class="mt-5">
          <PostMeta
            locale={locale}
            authorRef={entry.data.author.id}
            pubDate={entry.data.pubDate}
            updatedDate={updatedDate}
            readingMinutes={readingMinutes}
          />
        </div>
        {entry.data.proOnly && (
          <p class="mt-4 text-sm text-info">
            <span class="pro-badge mr-2">{t(locale as any, 'features.pro.title')}</span>
            {t(locale as any, 'features.pro.summary')}
          </p>
        )}
      </header>

      <div class="prose">
        <Content />
      </div>

      <RelatedPosts locale={locale} current={entry} pool={localePosts} />
    </div>

    <aside class="lg:sticky lg:top-20 self-start space-y-5">
      <PostToc locale={locale} headings={headings} />
      <SourceCallout locale={locale} />
    </aside>
  </article>
</BaseLayout>