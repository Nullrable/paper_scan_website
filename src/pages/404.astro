---
/**
 * Root 404 — English fallback served at /404.html.
 *
 * Each prefixed locale has its own copy under src/pages/[lang]/404.astro.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { t, localeUrl } from '../utils/i18n';

const locale = 'en';
---

<BaseLayout
  title="404"
  description="Page not found."
  noindex
  locale={locale}
  path="/404/"
>
  <section class="py-9 text-center">
    <p class="text-7xl md:text-9xl font-display font-semibold tracking-tight text-white">404</p>
    <h1 class="mt-5 text-2xl md:text-3xl text-white">This page is missing.</h1>
    <p class="mt-3 text-text-secondary">
      It may have been moved or never existed.
    </p>
    <a href={localeUrl(locale as any, '/')} class="btn btn-primary mt-7 inline-flex">
      Go home
    </a>
  </section>
</BaseLayout>