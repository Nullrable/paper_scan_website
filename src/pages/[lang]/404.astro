---
/**
 * Localized 404 — Astro will generate /<lang>/404.html per locale.
 * The /<lang>/<anything>/ URL falls back to this in static hosting.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES } from '../../consts';
import { t } from '../../utils/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang!;
---

<BaseLayout
  title="404"
  description="Page not found."
  noindex
  locale={locale}
  path="/404/"
>
  <section class="py-9 text-center">
    <p class="text-7xl md:text-9xl font-display font-semibold tracking-tight text-white">404</p>
    <h1 class="mt-5 text-2xl md:text-3xl text-white">
      {t(locale as any, 'common.backToBlog').includes('Back')
        ? 'This page is missing.'
        : '页面不存在。'}
    </h1>
    <p class="mt-3 text-text-secondary">
      {t(locale as any, 'common.backToBlog').includes('Back')
        ? 'It may have been moved or never existed.'
        : '页面可能已被移动或从未存在。'}
    </p>
    <a href={`/${locale}/`} class="btn btn-primary mt-7 inline-flex">
      {t(locale as any, 'common.learnMore').includes('Learn')
        ? 'Go home'
        : '返回首页'}
    </a>
  </section>
</BaseLayout>