---
/**
 * Localized home page — every locale except the default.
 *
 * `src/pages/index.astro` serves English at the root; this file covers
 * every other locale (zh, es, fr, de, ja, ko, pt). The shared body lives
 * in <HomePage> so the two pages stay in sync.
 */

import HomePage from '../../components/home/HomePage.astro';
import { LOCALES } from '../../consts';

export function getStaticPaths() {
  return LOCALES.filter((lang) => lang !== 'en').map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const locale = lang!;
---

<HomePage locale={locale} />