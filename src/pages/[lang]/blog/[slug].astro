---
/**
 * Blog detail — single post.
 *
 * Routes:
 *   /en/blog/ultra-wide-lens/   →   content/en/scanning/ultra-wide-lens.mdx
 *
 * The [slug] param is the basename of the MDX file (e.g. "ultra-wide-lens").
 * We resolve it against the locale using getCollection's id prefix.
 */

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostMeta from '../../../components/blog/PostMeta.astro';
import PostToc from '../../../components/blog/PostToc.astro';
import RelatedPosts from '../../../components/blog/RelatedPosts.astro';
import SourceCallout from '../../../components/blog/SourceCallout.astro';
import { LOCALES, SITE_URL } from '../../../consts';
import type { Locale } from '../../../consts';
import { t, localeUrl } from '../../../utils/i18n';
import {
  estimateReadingMinutes,
  sortByDateDesc,
} from '../../../utils/blog';

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  // English (default) is served at the root by src/pages/blog/[slug].astro;
  // this dynamic route only emits prefixed-locale entries.
  return all.flatMap((p) => {
    const lang = p.id.split('/')[0];
    if (lang === 'en') return [];
    const basename = (p.id.split('/').pop() ?? p.id).replace(/\.mdx?$/, '');
    return [{
      params: { lang, slug: basename },
      props: { locale: lang as Locale, slug: basename, entry: p },
    }];
  });
}

const props = Astro.props;
const { locale, entry } = props;
const { Content, headings } = await render(entry);

const all = await getCollection('blog', ({ data }) => !data.draft);
const localePosts = all
  .filter((p) => p.id.startsWith(`${locale}/`))
  .sort(sortByDateDesc);

const readingMinutes = estimateReadingMinutes(entry.body ?? '');
const updatedDate = entry.data.updatedDate;

// Available translations for hreflang: current locale plus every locale that
// the post's `translations` map points at (which may include the current
// locale itself; we de-dupe). Locales without a real translated page are
// omitted so Google doesn't index them and treat them as duplicates.
const basename = (entry.id.split('/').pop() ?? entry.id).replace(/\.mdx?$/, '');
const alternateLocales: Locale[] = Array.from(
  new Set<Locale>([
    locale as Locale,
    ...Object.keys(entry.data.translations ?? {}) as Locale[],
  ])
);

// Canonical URL for the current post (used as mainEntityOfPage.id and
// for hreflang targets — `localeUrl` returns the correct path for both
// root locale and prefixed locales).
const postPath = `/blog/${basename}/`;
const canonicalPostUrl = new URL(localeUrl(locale as any, postPath), SITE_URL).toString();
const postImage = entry.data.hero?.src
  ? new URL(entry.data.hero.src, SITE_URL).toString()
  : new URL('/og-default.png', SITE_URL).toString();

const blogPostingJsonLd = {
  '@type': 'BlogPosting',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalPostUrl,
  },
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: entry.data.author.id.replace(/-/g, ' '),
  },
  publisher: { '@id': new URL('/#organization', SITE_URL).toString() },
  image: [postImage],
  articleSection: entry.data.category,
  inLanguage: locale,
  keywords: entry.data.tags?.join(', '),
  wordCount: entry.body?.trim().split(/\s+/).filter(Boolean).length,
  url: canonicalPostUrl,
};

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(locale as any, 'nav.blog'),
      item: new URL(localeUrl(locale as any, '/blog/'), SITE_URL).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: entry.data.title,
      item: new URL(localeUrl(locale as any, `/blog/${(entry.id.split('/').pop() ?? entry.id).replace(/\.mdx?$/, '')}/`), SITE_URL).toString(),
    },
  ],
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  pubDate={entry.data.pubDate}
  updatedDate={updatedDate}
  locale={locale}
  path={postPath}
  alternateLocales={alternateLocales}
  jsonLd={[blogPostingJsonLd, breadcrumbJsonLd]}
>
  <a
    href={localeUrl(locale as any, '/blog/')}
    class="text-xs text-text-secondary hover:text-white inline-flex items-center gap-1 mb-4"
  >
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <polyline points="15,18 9,12 15,6" />
    </svg>
    {t(locale as any, 'common.backToBlog')}
  </a>

  <article class="grid gap-9 lg:grid-cols-[1fr_280px]">
    <div>
      <header class="mb-7">
        <h1 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-white text-balance">
          {entry.data.title}
        </h1>
        <p class="mt-3 text-lg text-text-secondary max-w-2xl text-balance">
          {entry.data.description}
        </p>
        <div class="mt-5">
          <PostMeta
            locale={locale}
            authorRef={entry.data.author.id}
            pubDate={entry.data.pubDate}
            updatedDate={updatedDate}
            readingMinutes={readingMinutes}
          />
        </div>
        {entry.data.proOnly && (
          <p class="mt-4 text-sm text-info">
            <span class="pro-badge mr-2">{t(locale as any, 'features.pro.title')}</span>
            {t(locale as any, 'features.pro.summary')}
          </p>
        )}
      </header>

      <div class="prose">
        <Content />
      </div>

      <RelatedPosts locale={locale} current={entry} pool={localePosts} />
    </div>

    <aside class="lg:sticky lg:top-20 self-start space-y-5">
      <PostToc locale={locale} headings={headings} />
      <SourceCallout locale={locale} />
    </aside>
  </article>
</BaseLayout>