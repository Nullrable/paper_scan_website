---
/**
 * Download page — root English version.
 *
 * `prefixDefaultLocale: false` means English is served at /download/ with
 * no /en/ prefix. The prefixed locales are handled by
 * src/pages/[lang]/download.astro.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIALS } from '../consts';
import { t } from '../utils/i18n';

const locale = 'en';
---

<BaseLayout
  title={t(locale as any, 'download.title')}
  description={t(locale as any, 'download.subtitle')}
  locale={locale}
  path="/download/"
>
  <header class="text-center max-w-2xl mx-auto mb-9">
    <h1 class="font-display text-4xl md:text-5xl font-semibold tracking-tight text-white">
      {t(locale as any, 'download.title')}
    </h1>
    <p class="mt-3 text-lg text-text-secondary">{t(locale as any, 'download.subtitle')}</p>
  </header>

  <div class="grid gap-7 sm:grid-cols-2 max-w-3xl mx-auto">
    <!-- iOS -->
    <div class="card text-center">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" class="mx-auto text-white" aria-hidden="true">
        <path d="M17.05 12.04c-.03-2.96 2.42-4.4 2.53-4.47-1.38-2.02-3.53-2.3-4.3-2.33-1.83-.18-3.57 1.08-4.5 1.08-.94 0-2.37-1.05-3.9-1.02-2 .03-3.86 1.17-4.89 2.96-2.09 3.62-.53 8.97 1.5 11.92 1 1.44 2.18 3.05 3.72 2.99 1.5-.06 2.06-.96 3.87-.96 1.81 0 2.31.96 3.9.93 1.61-.03 2.63-1.46 3.61-2.91 1.14-1.66 1.61-3.28 1.63-3.37-.04-.02-3.13-1.2-3.17-4.82zM14.4 3.3c.81-1 1.36-2.37 1.21-3.74-1.17.05-2.6.78-3.44 1.76-.74.86-1.4 2.27-1.22 3.59 1.31.1 2.65-.65 3.45-1.61z"/>
      </svg>
      <h2 class="mt-3 font-display text-xl font-semibold text-white">iOS</h2>
      <p class="mt-1 text-sm text-text-secondary">iPhone & iPad</p>
      <a
        href={SOCIALS.appStore}
        rel="noopener noreferrer"
        class="btn btn-primary mt-5 w-full justify-center"
      >
        {t(locale as any, 'download.ios')}
      </a>
    </div>

    <!-- Android -->
    {SOCIALS.playStore && (
      <div class="card text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" class="mx-auto text-white" aria-hidden="true">
          <path d="M17.523 15.34l1.83-3.17a.38.38 0 0 0-.66-.38l-1.85 3.2c-1.4-.59-3.02-.94-4.84-.94s-3.44.35-4.84.94L5.32 4.79a.38.38 0 0 0-.66.38l1.83 3.17C2.7 10.06 0 12.74 0 15.99h24c0-3.25-2.7-5.93-6.477-7.65zM7.34 13.85a.85.85 0 1 1 0-1.7.85.85 0 0 1 0 1.7zm9.32 0a.85.85 0 1 1 0-1.7.85.85 0 0 1 0 1.7z"/>
        </svg>
        <h2 class="mt-3 font-display text-xl font-semibold text-white">Android</h2>
        <p class="mt-1 text-sm text-text-secondary">Android 8.0+</p>
        <a
          href={SOCIALS.playStore}
          rel="noopener noreferrer"
          class="btn btn-primary mt-5 w-full justify-center"
        >
          {t(locale as any, 'download.android')}
        </a>
      </div>
    )}
  </div>

  <p class="mt-9 text-center text-xs text-text-muted">
    {t(locale as any, 'download.qrHelp')}
  </p>

  <div class="mt-9 flex justify-center">
    <a
      href={SOCIALS.github}
      rel="noopener noreferrer"
      class="btn btn-ghost text-sm"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.13c-3.2.7-3.87-1.37-3.87-1.37-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.96 10.96 0 0 1 5.74 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.57.23 2.73.11 3.02.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.25 5.65.41.35.78 1.05.78 2.12v3.14c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
      </svg>
      {t(locale as any, 'common.viewOnGitHub')}
    </a>
  </div>
</BaseLayout>