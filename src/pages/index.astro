---
/**
 * Root home — English (the default locale).
 *
 * `prefixDefaultLocale: false` in astro.config.mjs means English is
 * served from the site root with no /en/ prefix, so this file replaces
 * the older 308 redirect. The locale-relative body lives in <HomePage>
 * and is shared with src/pages/[lang]/index.astro for the other locales.
 */

import HomePage from '../components/home/HomePage.astro';
---

<HomePage locale="en" />