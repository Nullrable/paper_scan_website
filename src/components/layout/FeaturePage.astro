---
/**
 * FeaturePage — shared layout for every feature detail page.
 *
 * Renders:
 *   1. Hero (icon + title + summary + body)
 *   2. Use-cases list — concrete situations where the feature helps
 *   3. Pro callout (if applicable)
 *   4. Related feature links
 *
 * No code references, no module paths — this is a product site.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import { t, localeUrl } from "../../utils/i18n";

interface RelatedLink {
  href: string;
  label: string;
}

interface Props {
  locale: string;
  feature: {
    slug: string;
    icon: string;
    title: string;
    summary: string;
    body: string;
    useCases: string[];
    related: RelatedLink[];
    proHint?: string;
  };
}

const { locale, feature } = Astro.props;

const icons: Record<string, string> = {
  scan: "M3 7V5a2 2 0 0 1 2-2h2M21 7V5a2 2 0 0 0-2-2h-2M3 17v2a2 2 0 0 0 2 2h2M21 17v2a2 2 0 0 1-2 2h-2",
  filter:
    "M3 4h18l-7 9v6l-4 2v-8L3 4z",
  folder:
    "M3 7a2 2 0 0 1 2-2h4l2 3h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z",
  ocr: "M4 6h16M4 12h16M4 18h10M16 16l4 4M20 16l-4 4",
  pdf: "M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6z M14 3v6h6",
  cloud:
    "M18 10a5 5 0 0 0-9.95-1A5 5 0 0 0 7 15h11a4 4 0 0 0 0-8z",
};

const jsonLd = {
  "@type": "TechArticle",
  headline: feature.title,
  description: feature.summary,
  about: {
    "@type": "SoftwareApplication",
    name: "Paper Scanner",
  },
};
---

<BaseLayout
  title={feature.title}
  description={feature.summary}
  locale={locale}
  path={`/features/${feature.slug}/`}
  jsonLd={jsonLd}
>
  <article class="max-w-3xl">
    <a
      href={localeUrl(locale as any, '/features/')}
      class="text-xs text-text-secondary hover:text-white inline-flex items-center gap-1 mb-4"
    >
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <polyline points="15,18 9,12 15,6" />
      </svg>
      {t(locale as any, "nav.features")}
    </a>

    <header class="flex items-start gap-4 mb-7">
      <span
        class="shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-lg bg-bg-2 border border-border-subtle"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={icons[feature.icon] ?? icons.scan} />
        </svg>
      </span>
      <div>
        <h1
          class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-white text-balance"
        >
          {feature.title}
        </h1>
        <p class="mt-2 text-text-secondary text-lg max-w-2xl">
          {feature.summary}
        </p>
      </div>
    </header>

    <div class="prose">
      <p>{feature.body}</p>
    </div>

    {feature.useCases.length > 0 && (
      <section class="mt-9">
        <h2
          class="font-display text-xl font-semibold text-white mb-3"
        >
          {locale === "zh" ? "什么时候用" : "When to use it"}
        </h2>
        <ul class="space-y-2.5">
          {feature.useCases.map((useCase) => (
            <li class="flex items-start gap-2.5 text-text-secondary">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="mt-1 shrink-0 text-success"
                aria-hidden="true"
              >
                <polyline points="20,6 9,17 4,12" />
              </svg>
              <span>{useCase}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {feature.proHint && (
      <aside class="card mt-9 border-info/30 bg-info/5">
        <div class="flex items-start gap-3">
          <span class="pro-badge">
            {t(locale as any, "features.pro.title")}
          </span>
          <div>
            <h3 class="font-display text-base font-semibold text-white">
              {t(locale as any, "features.pro.title")}
            </h3>
            <p class="mt-1 text-sm text-text-secondary">{feature.proHint}</p>
            <a
              href={localeUrl(locale as any, '/features/pro/')}
              class="mt-3 inline-flex items-center gap-1 text-sm text-info hover:underline"
            >
              {t(locale as any, "common.learnMore")}
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <polyline points="9,18 15,12 9,6" />
              </svg>
            </a>
          </div>
        </div>
      </aside>
    )}

    {feature.related.length > 0 && (
      <section class="mt-9">
        <h2 class="font-display text-xl font-semibold text-white mb-3">
          {t(locale as any, "common.relatedPosts")}
        </h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {feature.related.map((link) => (
            <li>
              <a
                href={link.href}
                class="card flex items-center justify-between text-sm text-text-secondary hover:text-white"
              >
                <span>{link.label}</span>
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <polyline points="9,18 15,12 9,6" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>