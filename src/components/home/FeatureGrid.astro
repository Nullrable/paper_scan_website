---
/**
 * FeatureGrid — feature cards linking to detail pages.
 */

import { t } from '../../utils/i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const features = [
  {
    key: 'scanning',
    href: `/${locale}/features/scanning/`,
    icon: 'scan',
  },
  {
    key: 'filters',
    href: `/${locale}/features/filters/`,
    icon: 'filter',
  },
  {
    key: 'documents',
    href: `/${locale}/features/documents/`,
    icon: 'folder',
  },
  {
    key: 'ocr',
    href: `/${locale}/features/ocr/`,
    icon: 'ocr',
  },
  {
    key: 'pdf',
    href: `/${locale}/features/pdf-export/`,
    icon: 'pdf',
  },
  {
    key: 'cloud',
    href: `/${locale}/features/cloud-sync/`,
    icon: 'cloud',
  },
  {
    key: 'pro',
    href: `/${locale}/features/pro/`,
    icon: 'star',
  },
];

const icons: Record<string, string> = {
  scan: 'M3 7V5a2 2 0 0 1 2-2h2M21 7V5a2 2 0 0 0-2-2h-2M3 17v2a2 2 0 0 0 2 2h2M21 17v2a2 2 0 0 1-2 2h-2',
  filter: 'M3 4h18l-7 9v6l-4 2v-8L3 4z',
  folder: 'M3 7a2 2 0 0 1 2-2h4l2 3h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z',
  ocr: 'M4 6h16M4 12h16M4 18h10M16 16l4 4M20 16l-4 4',
  pdf: 'M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6z M14 3v6h6',
  cloud: 'M18 10a5 5 0 0 0-9.95-1A5 5 0 0 0 7 15h11a4 4 0 0 0 0-8z',
  star: 'M12 2l3 6.5 7 .9-5 4.7 1.3 7L12 17.8 5.7 21l1.3-7-5-4.7 7-.9z',
};
---

<section class="py-9 md:py-12">
  <div class="text-center max-w-2xl mx-auto mb-9">
    <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-white">
      {t(locale as any, 'features.title')}
    </h2>
    <p class="mt-3 text-text-secondary">{t(locale as any, 'features.subtitle')}</p>
  </div>

  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((feature) => (
      <li>
        <a href={feature.href} class="card group block h-full">
          <div class="flex items-start gap-4">
            <span class="shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-md bg-bg-2 border border-border-subtle group-hover:border-border-strong transition-colors duration-base">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={icons[feature.icon]} />
              </svg>
            </span>
            <div class="min-w-0">
              <h3 class="font-display text-lg font-semibold text-white">
                {t(locale as any, `features.${feature.key}.title` as any)}
              </h3>
              <p class="mt-2 text-sm text-text-secondary leading-relaxed">
                {t(locale as any, `features.${feature.key}.summary` as any)}
              </p>
              <span class="mt-3 inline-flex items-center gap-1 text-xs text-text-secondary group-hover:text-white transition-colors duration-base">
                {t(locale as any, 'common.learnMore')}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="9,18 15,12 9,6" />
                </svg>
              </span>
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>