---
/**
 * ScreenshotShowcase — real app screenshots, in upload order.
 *
 * Six iOS capture frames (1320×2868 source), rendered via Astro's <Image>
 * component so they get hashed, optimised (avif/webp), and width-served.
 * Display order matches the upload sequence — do not reorder without
 * rebuilding the marketing narrative around the new order.
 */

import { Picture } from 'astro:assets';
import { t } from '../../utils/i18n';

import shot1 from '../../assets/screenshots/ios_1_1.jpg';
import shot2 from '../../assets/screenshots/ios_1_2.jpg';
import shot3 from '../../assets/screenshots/ios_1_3.jpg';
import shot4 from '../../assets/screenshots/ios_1_4.jpg';
import shot5 from '../../assets/screenshots/ios_1_5.jpg';
import shot6 from '../../assets/screenshots/ios_1_6.jpg';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const isZh = locale === 'zh';

const screenshots = [
  {
    src: shot1,
    label: isZh ? '预览扫描结果' : 'Preview, retake, or extract',
    alt: isZh
      ? '扫描后的预览页面，提供 Retake / Edit / Extract Text 三个操作'
      : 'Scan preview screen with Retake, Edit, and Extract Text actions',
  },
  {
    src: shot2,
    label: isZh ? '实时取景自动对焦' : 'Aim, focus, capture',
    alt: isZh
      ? '相机取景器自动识别文档边界并显示对焦状态'
      : 'Camera viewfinder auto-detecting document edges and focusing',
  },
  {
    src: shot3,
    label: isZh ? '设备端 OCR 提取文字' : 'On-device OCR with one-tap copy',
    alt: isZh
      ? 'OCR 识别结果面板，包含原始文本与一键复制按钮'
      : 'OCR result sheet with the recognised text and a Copy All action',
  },
  {
    src: shot4,
    label: isZh ? '导出 PDF / JPEG / 文本' : 'Export to PDF, JPEG, or text',
    alt: isZh
      ? '导出对话框，支持 PDF / JPEG / Text 三种格式，可设密码与权限'
      : 'Export sheet with PDF, JPEG, and Text formats plus password and permissions',
  },
  {
    src: shot5,
    label: isZh ? '5 种标注工具' : 'Pen, shapes, highlight, text',
    alt: isZh
      ? '标注工具栏：画笔、矩形、箭头、高亮、文字'
      : 'Annotation toolbar with Pen, Rectangle, Arrow, Highlight, and Text tools',
  },
  {
    src: shot6,
    label: isZh ? '页面级编辑操作' : 'Crop, filter, rotate — per page',
    alt: isZh
      ? '页面操作工具：裁剪、滤镜、调整、旋转、移动、复制、重置、删除页面'
      : 'Page actions: Crop, Filter, Adjust, Rotate, Move, Copy, Reset, Delete Page',
  },
];
---

<section class="py-9 md:py-12">
  <div class="text-center max-w-2xl mx-auto mb-9">
    <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-white">
      {t(locale as any, 'homepage.screenshots.title')}
    </h2>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {screenshots.map((s) => (
      <figure class="card group p-4">
        <div class="aspect-[9/16] bg-bg-0 border border-border-subtle rounded-md overflow-hidden">
          <Picture
            src={s.src}
            alt={s.alt}
            widths={[320, 480, 640, 800]}
            sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 320px"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            quality={75}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
        <figcaption class="mt-3">
          <div class="text-white text-sm font-medium">{s.label}</div>
        </figcaption>
      </figure>
    ))}
  </div>
</section>