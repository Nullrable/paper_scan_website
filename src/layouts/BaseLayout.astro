---
/**
 * BaseLayout — top-level layout.
 * Sets <html lang>, applies theme tokens, and stacks Header / slot / Footer.
 *
 * Children must be passed via Astro's <slot /> mechanism.
 */

import '../styles/global.css';
import SeoHead from '../components/seo/SeoHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE_NAME, SITE_URL, SOCIALS } from '../consts';
import type { Locale } from '../consts';
import { t } from '../utils/i18n';
import { jsonLdScript } from '../utils/jsonld';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
  /** Path relative to locale root (no leading locale). Used for canonical/hreflang. */
  path?: string;
  locale: string;
  /**
   * Locales that have a real translated page at this path. When set, only
   * these locales (plus x-default) appear in hreflang alternates. When
   * omitted, all 8 locales are emitted — used for static pages that exist
   * in every locale by virtue of the [lang] dynamic route.
   */
  alternateLocales?: Locale[];
  /** og:article:section — high-level category. */
  articleSection?: string;
  /** og:article:tag — one <meta> per entry. */
  articleTags?: string[];
  /** Optional JSON-LD blocks. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image,
  type = 'website',
  pubDate,
  updatedDate,
  noindex = false,
  path = '/',
  locale,
  alternateLocales,
  articleSection,
  articleTags,
  jsonLd,
} = Astro.props;

const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

// Default JSON-LD: Organization + WebSite on every page. Organization powers
// the brand knowledge panel; WebSite gives Google the site-wide identity.
//
// SearchAction is intentionally omitted: there is no `/search` route yet, and
// pointing Google's sitelinks searchbox at a 404 breaks the feature. Re-add it
// (and a matching /search page) when site search ships.
const defaultJsonLd = [
  {
    '@type': 'Organization',
    '@id': new URL('/#organization', SITE_URL).toString(),
    name: SITE_NAME,
    url: SITE_URL,
    description:
      'A pro document scanner for iOS and Android — ultra-wide capture, GPU filters, OCR, multi-page PDF, Google Drive & iCloud sync.',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/icon-512.png', SITE_URL).toString(),
      width: 512,
      height: 512,
    },
    foundingDate: '2024',
    sameAs: [SOCIALS.github, SOCIALS.appStore].filter(Boolean),
  },
  {
    '@type': 'WebSite',
    '@id': new URL('/#website', SITE_URL).toString(),
    url: SITE_URL,
    name: SITE_NAME,
    inLanguage: ['en-US', 'zh-CN', 'es-ES', 'fr-FR', 'de-DE', 'ja-JP', 'ko-KR', 'pt-BR'],
    publisher: { '@id': new URL('/#organization', SITE_URL).toString() },
  },
];

const jsonLdPayload = jsonLd
  ? Array.isArray(jsonLd)
    ? [...defaultJsonLd, ...jsonLd]
    : [...defaultJsonLd, jsonLd]
  : defaultJsonLd;

const jsonLdHtml = jsonLdScript(jsonLdPayload);
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <SeoHead
      title={fullTitle}
      description={description}
      image={image}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      noindex={noindex}
      path={path}
      locale={locale}
      alternateLocales={alternateLocales}
      articleSection={articleSection}
      articleTags={articleTags}
    />
    <Fragment set:html={jsonLdHtml} />
  </head>
  <body class="gradient-mesh min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-3 focus:py-2 focus:rounded-md focus:bg-white focus:text-black focus:text-sm">
      {t(locale as any, 'nav.skipToContent')}
    </a>

    <Header locale={locale} path={path} />

    <main id="main" class="container-app py-7 md:py-9">
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>